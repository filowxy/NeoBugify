# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# NeoForge ModDevGradle run output: generated worlds, logs, and the dev client
# and server config. Everything here is reproducible from a build.
run/

# Scratch tooling used while porting: a local Gradle distribution, unpacked
# dependency jars and captured build logs. Roughly 275 MB, none of it source.
_tools/

# Upstream Debugify checkout kept around as the reference for the port. The
# ported result lives in src/, so tracking a second copy of the same upstream
# code would be confusing. Its license is LGPL-3.0-only, see LICENSE and NOTICE.
_work/

# Decompiled vanilla mappings used by _verify/audit_mixins.py. 30 MB of
# generated bytecode, regenerable on demand. The scripts themselves are tracked.
_verify/maps/

# Scratch output from the audit runs.
_verify/*.txt
_verify/gradle.cmd

# Third party jars that were only used while porting. The one jar the build
# actually compiles against lives in libs/ and IS tracked, because
# build.gradle.kts resolves YACL from libs/ rather than from a Maven
# coordinate. See PORTING-NOTES.md for how to replace it with a real
# dependency if you would rather not vendor the binary.
architectury-*.jar
Debugify-*.jar
yet_another_config_lib_v3-*.jar
!libs/yet_another_config_lib_v3-*.jar

# IDE
.idea/
*.iml
.vscode/
.classpath
.project
.settings/
bin/
out/
